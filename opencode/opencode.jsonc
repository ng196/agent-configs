{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["@dietrichgebert/ponytail"],
  "provider": {
    "opencode-go": {
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1"
      }
    }
  },
  "instructions": ["C:/Users/nitin/.config/opencode/AGENTS.md"],
  "skills": {
    "paths": [
      "C:/Users/nitin/.claude/skills",
      "C:/Users/nitin/.agents/skills"
    ]
  },
  "mcp": {
    "memory": {
      "type": "local",
      "command": [
        "C:/Program Files/nodejs/node.exe",
        "C:/Users/nitin/AppData/Roaming/npm/node_modules/@modelcontextprotocol/server-memory/dist/index.js"
      ]
    }
  },
  "permission": {
    "skill": "allow",
    "external_directory": {
      "~/.task-observer/**": "allow",
      "~/.agents/skills/**": "allow",
      "~/.claude/skills/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/.cache/opencode/**": "allow"
    }
  }
}
